   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of outliers: 824\n"
     ]
    }
   ],
   "source": [
    "Q1 = df[\"tenure\"].quantile(0.25)\n",
    "Q3 = df[\"tenure\"].quantile(0.75)\n",
    "\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "lower = Q1 - 1.5 * IQR\n",
    "upper = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = df[\n",
    "    (df[\"tenure\"] < lower) |\n",
    "    (df[\"tenure\"] > upper)]\n",
    "\n",
    "print(\"Number of outliers:\", outliers.shape[0])"
   ]
